# ---- LLM (required) ----------------------------------------------------------
# Any OpenAI-compatible endpoint works; DeepSeek is the default.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Vision APIs (optional, used by the image <-> text check) ----------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# ---- Search APIs (optional, used by source verification) ---------------------
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- Redis (optional; Docker Compose sets these automatically) ---------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
